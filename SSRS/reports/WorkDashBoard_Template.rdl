                                <PaddingBottom>4pt</PaddingBottom>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="TotalAchieved">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=Sum(Fields!Performance.Value, "Performance") / IIF(Sum(Fields!Goal.Value, "Goals")=0, 1, Sum(Fields!Goal.Value, "Goals"))</Value>
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
                                        <FontSize>9pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <Format>0.0%</Format>
                                        <Color>=IIF(Sum(Fields!Performance.Value, "Performance") &gt;= Sum(Fields!Goal.Value, "Goals"), "#16a34a", "#dc2626")</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Right</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
