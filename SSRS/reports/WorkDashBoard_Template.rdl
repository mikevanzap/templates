  <DataSets>
    <DataSet Name="Goals">
      <Query>
        <DataSourceName>WorkDashBoard</DataSourceName>
        <CommandText>SELECT Employee, Goal FROM dbo.vw_SSRS_Goals ORDER BY Employee;</CommandText>
      </Query>
      <Fields>
        <Field Name="Employee">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Employee</DataField>
        </Field>
        <Field Name="Goal">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Goal</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Performance">
      <Query>
        <DataSourceName>WorkDashBoard</DataSourceName>
        <CommandText>SELECT Employee, Performance FROM dbo.vw_SSRS_Performance ORDER BY Employee;</CommandText>
      </Query>
      <Fields>
        <Field Name="Employee">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Employee</DataField>
        </Field>
        <Field Name="Performance">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Performance</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
