                            </Textbox>
                          </CellContents>
                        </TablixCell>
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="TotalVariance">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=Sum(Fields!Performance.Value, "Performance") - Sum(Fields!Goal.Value, "Goals")</Value>
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
                                        <FontSize>9pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <Format>+###,##0.00;-###,##0.00;0.00</Format>
                                        <Color>=IIF(Sum(Fields!Performance.Value, "Performance") &gt;= Sum(Fields!Goal.Value, "Goals"), "#16a34a", "#dc2626")</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Right</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
