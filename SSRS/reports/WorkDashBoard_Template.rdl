                                  <Style>Solid</Style>
                                </Border>
                                <TopBorder>
                                  <Color>#007cb1</Color>
                                  <Style>Solid</Style>
                                  <Width>1.5pt</Width>
                                </TopBorder>
                                <BackgroundColor>=IIF(Sum(Fields!Performance.Value, "Performance") &gt;= Sum(Fields!Goal.Value, "Goals"), "#dcfce7", "#fee2e2")</BackgroundColor>
                                <PaddingLeft>2pt</PaddingLeft>
                                <PaddingRight>2pt</PaddingRight>
                                <PaddingTop>4pt</PaddingTop>
                                <PaddingBottom>4pt</PaddingBottom>
                              </Style>
                            </Textbox>
                          </CellContents>
