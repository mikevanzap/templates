                                <Border>
                                  <Color>#e2e8f0</Color>
                                  <Style>Solid</Style>
                                </Border>
                                <BackgroundColor>=IIF(Fields!Employee.Value = Parameters!Employee.Value, "#eff6ff", IIF(RowNumber(Nothing) Mod 2 = 0, "#f8fafc", "White"))</BackgroundColor>
                                <PaddingLeft>2pt</PaddingLeft>
                                <PaddingRight>5pt</PaddingRight>
                                <PaddingTop>3pt</PaddingTop>
                                <PaddingBottom>3pt</PaddingBottom>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="EmployeeVariance">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=Sum(Fields!Performance.Value) - Lookup(Fields!Employee.Value, Fields!Employee.Value, Fields!Goal.Value, "Goals")</Value>
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
                                        <FontSize>8.5pt</FontSize>
                                        <Format>+###,##0.00;-###,##0.00;0.00</Format>
                                        <Color>=IIF(Sum(Fields!Performance.Value) &gt;= Lookup(Fields!Employee.Value, Fields!Employee.Value, Fields!Goal.Value, "Goals"), "#16a34a", "#dc2626")</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Right</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Color>#e2e8f0</Color>
                                  <Style>Solid</Style>
                                </Border>
                                <BackgroundColor>=IIF(Fields!Employee.Value = Parameters!Employee.Value, "#eff6ff", IIF(RowNumber(Nothing) Mod 2 = 0, "#f8fafc", "White"))</BackgroundColor>
                                <PaddingLeft>2pt</PaddingLeft>
                                <PaddingRight>5pt</PaddingRight>
                                <PaddingTop>3pt</PaddingTop>
                                <PaddingBottom>3pt</PaddingBottom>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="EmployeeAchieved">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=Sum(Fields!Performance.Value) / IIF(Lookup(Fields!Employee.Value, Fields!Employee.Value, Fields!Goal.Value, "Goals") = 0, 1, Lookup(Fields!Employee.Value, Fields!Employee.Value, Fields!Goal.Value, "Goals"))</Value>
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
                                        <FontSize>8.5pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <Format>0.0%</Format>
                                        <Color>=IIF(Sum(Fields!Performance.Value) &gt;= Lookup(Fields!Employee.Value, Fields!Employee.Value, Fields!Goal.Value, "Goals"), "#16a34a", IIF(Sum(Fields!Performance.Value) &gt;= 0.8 * Lookup(Fields!Employee.Value, Fields!Employee.Value, Fields!Goal.Value, "Goals"), "#d97706", "#dc2626"))</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Right</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Color>#e2e8f0</Color>
                                  <Style>Solid</Style>
                                </Border>
                                <BackgroundColor>=IIF(Fields!Employee.Value = Parameters!Employee.Value, "#eff6ff", IIF(RowNumber(Nothing) Mod 2 = 0, "#f8fafc", "White"))</BackgroundColor>
                                <PaddingLeft>2pt</PaddingLeft>
                                <PaddingRight>5pt</PaddingRight>
                                <PaddingTop>3pt</PaddingTop>
                                <PaddingBottom>3pt</PaddingBottom>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="EmployeeStatus">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=IIF(Sum(Fields!Performance.Value) &gt;= Lookup(Fields!Employee.Value, Fields!Employee.Value, Fields!Goal.Value, "Goals"), "[MET] Met Goal", IIF(Sum(Fields!Performance.Value) &gt;= 0.8 * Lookup(Fields!Employee.Value, Fields!Employee.Value, Fields!Goal.Value, "Goals"), "[!] Near Goal", "[X] Behind"))</Value>
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
                                        <FontSize>8pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <Color>=IIF(Sum(Fields!Performance.Value) &gt;= Lookup(Fields!Employee.Value, Fields!Employee.Value, Fields!Goal.Value, "Goals"), "#166534", IIF(Sum(Fields!Performance.Value) &gt;= 0.8 * Lookup(Fields!Employee.Value, Fields!Employee.Value, Fields!Goal.Value, "Goals"), "#92400e", "#991b1b"))</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Color>#e2e8f0</Color>
                                  <Style>Solid</Style>
                                </Border>
                                <BackgroundColor>=IIF(Sum(Fields!Performance.Value) &gt;= Lookup(Fields!Employee.Value, Fields!Employee.Value, Fields!Goal.Value, "Goals"), "#dcfce7", IIF(Sum(Fields!Performance.Value) &gt;= 0.8 * Lookup(Fields!Employee.Value, Fields!Employee.Value, Fields!Goal.Value, "Goals"), "#fef3c7", "#fee2e2"))</BackgroundColor>
                                <PaddingLeft>2pt</PaddingLeft>
                                <PaddingRight>2pt</PaddingRight>
                                <PaddingTop>3pt</PaddingTop>
                                <PaddingBottom>3pt</PaddingBottom>
                              </Style>
                            </Textbox>
                          </CellContents>
