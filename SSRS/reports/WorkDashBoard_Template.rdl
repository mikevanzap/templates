                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=Sum(Fields!Performance.Value, "Performance")</Value>
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
