                        <TablixCell>
                          <CellContents>
                            <Textbox Name="EmployeePerformance">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=Sum(Fields!Performance.Value)</Value>
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
                                        <FontSize>8.5pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <Format>###,##0.00</Format>
                                        <Color>#0f172a</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Right</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
