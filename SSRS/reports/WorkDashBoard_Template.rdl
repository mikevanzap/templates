                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=Lookup(Fields!Employee.Value, Fields!Employee.Value, Fields!Goal.Value, "Goals")</Value>
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
                                        <FontSize>8.5pt</FontSize>
                                        <Format>###,##0.00</Format>
                                        <Color>#334155</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
